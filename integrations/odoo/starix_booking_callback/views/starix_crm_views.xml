<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="starix_crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.starix.information</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="x_gap_booking_id" invisible="1"/>
                <button name="action_open_starix_meeting" type="object" string="Entrar a videollamada STARIX" class="btn-primary" invisible="not x_gap_booking_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Información STARIX" name="starix_information">
                    <group string="Diagnóstico">
                        <group>
                            <field name="starix_area_label" readonly="1"/>
                            <field name="starix_status_label" readonly="1"/>
                            <field name="x_gap_completed_at" string="Diagnóstico completado" readonly="1"/>
                        </group>
                        <group>
                            <field name="starix_route_label" readonly="1"/>
                        </group>
                    </group>
                    <group string="Reserva">
                        <group>
                            <field name="x_gap_booking_at" string="Fecha de videollamada" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Respuestas del diagnóstico"/>
                    <div class="w-100">
                        <field name="starix_diagnostic_summary" readonly="1" nolabel="1" widget="html" class="w-100"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
